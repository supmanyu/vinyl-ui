{
  "name": "vinyl-ui-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:pkg": "turbo run check:pkg",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  }
}
