{
  "name": "@vinyl-ui/tokens",
  "version": "0.2.0",
  "description": "Vinyl UI design tokens: an 80s multi-colour palette for Tailwind v4 (web) and Uniwind (React Native).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supmanyu/vinyl-ui.git",
    "directory": "packages/tokens"
  },
  "keywords": [
    "design-tokens",
    "tailwindcss",
    "uniwind",
    "shadcn",
    "react-native",
    "80s",
    "retro"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web.css": "./dist/web.css",
    "./palette.css": "./dist/palette.css",
    "./native.css": "./dist/native.css",
    "./shadcn.json": "./dist/shadcn.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./web.css ./palette.css ./native.css"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/culori": "^4.0.1",
    "@types/node": "^24",
    "culori": "^4.0.2",
    "publint": "^0.3.25",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
